# Copy to .env and fill in. Never commit .env.

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
LOG_FORMAT=text                     # text | json (json is the default in production)
# ENABLE_DOCS=true                  # /docs is off by default in production

# ── Security ───────────────────────────────────────────────────────────────
# Shared key the app sends as X-API-Key. Leave empty to disable (dev only).
# Note: a key shipped inside a mobile app can be extracted — it stops casual
# abuse, not a determined attacker. Pair it with rate limits.
API_KEY=
# Comma-separated origins allowed to call the API from a browser (Flutter web).
ALLOWED_ORIGINS=http://localhost:5000
RATE_LIMIT_SEARCH_PER_MIN=10        # per client IP; 0 disables
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=120

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia                 # nvidia | gemini
NVIDIA_API_KEY=your_nvidia_api_key_here      # https://build.nvidia.com/
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_TEMPERATURE=1
# NVIDIA_MAX_TOKENS=16384
# NVIDIA_ENABLE_THINKING=1
GEMINI_API_KEY=your_gemini_api_key_here      # https://aistudio.google.com/app/apikey
LLM_TIMEOUT_SECONDS=30

# ── Search ──────────────────────────────────────────────────────────────────
SCRAPE_TIMEOUT_SECONDS=45
# SCRAPER_WORKERS=16

# ── Database ────────────────────────────────────────────────────────────────
# Empty → SQLite at results/sessions.db. docker-compose builds this for you.
DATABASE_URL=
POSTGRES_PASSWORD=change-me

# ── Observability (optional) ────────────────────────────────────────────────
AGENT_MONITOR=0                     # 1 to enable the AgentMonitor dashboard
# AGENT_MONITOR_PORT=8765
# INSTALL_MONITORING=true           # docker build arg: install AgentMonitor
